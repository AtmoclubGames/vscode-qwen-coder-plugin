--- package.json (原始)
{
  "name": "qwen-coder-bridge",
  "displayName": "Qwen Coder Bridge",
  "description": "Мост между VS Code и Qwen Coder API - отправляйте запросы и файлы, получайте ответы и редактируйте код",
  "version": "0.0.1",
  "publisher": "qwen-coder-bridge",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "qwen-coder-bridge",
          "title": "Qwen Coder Bridge",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "qwen-coder-bridge": [
        {
          "type": "webview",
          "id": "qwenCoderBridge.chatView",
          "name": "Чат с Qwen Coder",
          "icon": "$(comment-discussion)",
          "contextualTitle": "Qwen Coder Bridge"
        }
      ]
    },
    "commands": [
      {
        "command": "qwenCoderBridge.sendMessage",
        "title": "Отправить сообщение в Qwen Coder",
        "category": "Qwen Coder Bridge"
      },
      {
        "command": "qwenCoderBridge.addFileToContext",
        "title": "Добавить файл в контекст",
        "category": "Qwen Coder Bridge"
      },
      {
        "command": "qwenCoderBridge.applyChanges",
        "title": "Применить изменения из ответа",
        "category": "Qwen Coder Bridge"
      }
    ],
    "configuration": {
      "title": "Qwen Coder Bridge",
      "properties": {
        "qwenCoderBridge.apiEndpoint": {
          "type": "string",
          "default": "https://coder.qwen.ai/api",
          "description": "URL эндпоинта Qwen Coder API"
        },
        "qwenCoderBridge.apiKey": {
          "type": "string",
          "default": "",
          "description": "API ключ для доступа к Qwen Coder (если требуется)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "@types/node": "^20.x",
    "typescript": "^5.x"
  }
}

+++ package.json (修改后)
{
  "name": "qwen-coder-bridge",
  "displayName": "Qwen Coder Bridge",
  "description": "Мост между VS Code и Qwen Coder API - отправляйте запросы и файлы, получайте ответы и редактируйте код",
  "version": "0.0.1",
  "publisher": "qwen-coder-bridge",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other",
    "Machine Learning"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "qwen-coder-bridge",
          "title": "Qwen Coder Bridge",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "qwen-coder-bridge": [
        {
          "type": "webview",
          "id": "qwenCoderBridge.chatView",
          "name": "Чат с Qwen Coder",
          "icon": "$(comment-discussion)",
          "contextualTitle": "Qwen Coder Bridge"
        }
      ]
    },
    "commands": [
      {
        "command": "qwenCoderBridge.sendMessage",
        "title": "Отправить сообщение в Qwen Coder",
        "category": "Qwen Coder Bridge"
      },
      {
        "command": "qwenCoderBridge.addFileToContext",
        "title": "Добавить файл в контекст",
        "category": "Qwen Coder Bridge"
      },
      {
        "command": "qwenCoderBridge.applyChanges",
        "title": "Применить изменения из ответа",
        "category": "Qwen Coder Bridge"
      }
    ],
    "configuration": {
      "title": "Qwen Coder Bridge",
      "properties": {
        "qwenCoderBridge.apiEndpoint": {
          "type": "string",
          "default": "https://coder.qwen.ai/api",
          "description": "URL эндпоинта Qwen Coder API"
        },
        "qwenCoderBridge.apiKey": {
          "type": "string",
          "default": "",
          "description": "API ключ для доступа к DashScope API (резервный вариант)"
        },
        "qwenCoderBridge.useProxy": {
          "type": "boolean",
          "default": true,
          "description": "Использовать прокси-сервер для работы с coder.qwen.ai (рекомендуется)"
        },
        "qwenCoderBridge.proxyUrl": {
          "type": "string",
          "default": "http://localhost:3000",
          "description": "URL локального прокси-сервера"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.95.0",
    "@types/node": "^20.x",
    "typescript": "^5.x"
  }
}