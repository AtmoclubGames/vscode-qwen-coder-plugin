datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Бывшая Kitchen. Теперь мультивендорная модель (Фермер / Повар)
model Vendor {
  id          String        @id @default(uuid())
  name        String
  description String?
  type        String        @default("Фермер") // "Фермер", "Домашние торты", "Пекарня"
  rating      Float         @default(5.0)
  address     String?
  latitude    Float?
  longitude   Float?
  menuItems   MenuItem[]
  reviews     Review[]
}

// Промежуточный хаб для логистики автопарка
model Hub {
  id          String   @id @default(uuid())
  name        String   // Например, "Сортировочный Центр Север"
  address     String
  latitude    Float
  longitude   Float
}

// Точки доставки "последней мили" (клиент забирает здесь или курьер несет отсюда)
model PickupPoint {
  id          String   @id @default(uuid())
  name        String   // Например, "Точка #1: Спуск Золотой пляж"
  latitude    Float
  longitude   Float
  orders      Order[]
}

model MenuItem {
  id              String      @id @default(uuid())
  name            String
  description     String
  price           Float
  imageUrl        String?
  weight          String?     
  unitType        String      @default("порция") // "шт", "кг", "порция", "литр"
  ingredients     String?     
  likesCount      Int         @default(0)
  vendorId        String
  vendor          Vendor      @relation(fields: [vendorId], references: [id])
  isPreorderOnly  Boolean     @default(false) // Предзаказ фермерских продуктов (напр. мясо через неделю)
  availableFrom   DateTime?   // Дата доступности свежей партии
  stocks          DailyStock[]
  orderItems      OrderItem[]
}

model DailyStock {
  id          String   @id @default(uuid())
  date        DateTime
  menuItemId  String
  menuItem    MenuItem @relation(fields: [menuItemId], references: [id])
  slotStart   String   // Глобальные слоты развозки (напр. "18:00")
  slotEnd     String   // "20:00"
  totalCount  Int      
  bookedCount Int      @default(0) 
}

model Order {
  id            String      @id @default(uuid())
  orderNumber   Int         
  messenger     String      
  clientTgId    String      
  clientName    String
  clientPhone   String
  clientComment String?     
  pickupPointId String
  pickupPoint   PickupPoint @relation(fields: [pickupPointId], references: [id])
  slotDate      DateTime
  slotTime      String      // Выбранный слот доставки (напр. "Вечер 18:00-20:00")
  status        String      // PENDING, PAYMENT_HELD, PREPARING, AT_HUB, DELIVERING, READY, COMPLETED, CANCELLED
  paymentStatus String      @default("PENDING") // PENDING, HELD, PAID, REFUNDED
  isExpress     Boolean     @default(false) // Срочная доставка за доп. плату
  courierName   String?     // Локальный пеший курьер (последняя миля)
  items         OrderItem[]
  tasks         LogisticsTask[] // Задания для автопарка
  createdAt     DateTime    @default(now())
}

model OrderItem {
  id         String   @id @default(uuid())
  orderId    String
  order      Order    @relation(fields: [orderId], references: [id])
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id])
  quantity   Int
  status     String   @default("PENDING") // PENDING, PREPARED_BY_VENDOR, AT_HUB
}

// Маршрутные листы / Задания для водителя
model LogisticsTask {
  id          String   @id @default(uuid())
  type        String   // PICKUP_VENDOR (забрать у фермера), DROPOFF_HUB (отвезти на хаб)
  status      String   @default("PENDING") // PENDING, EN_ROUTE, COMPLETED
  driverName  String?  // Идентификатор машины/водителя
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  targetLat   Float
  targetLng   Float
  address     String
  sortOrder   Int      @default(0) // Порядок точки в маршруте (настраивается логистом)
}

// Отзывы покупателей о вендорах
model Review {
  id        String   @id @default(uuid())
  text      String
  rating    Int      // 1 to 5
  vendorId  String
  vendor    Vendor   @relation(fields: [vendorId], references: [id])
  clientName String
  createdAt DateTime @default(now())
}
